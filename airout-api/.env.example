# Copy to .env for local overrides. Development defaults also exist in src/config/env.ts.
# Never put production secrets in the mobile app. LLM and mail credentials stay on the server.

NODE_ENV=development
PORT=4000

DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=airout
DB_USER=airout
DB_PASSWORD=airout_dev_password
DB_LOGGING=false

# Required in production. Development falls back to obvious local defaults.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Optional. When empty, conversations use the labeled mock listener.
# The key is read only on the server and is never sent to the phone.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional. When empty, verification and reset tokens are created but not emailed.
MAIL_PROVIDER=

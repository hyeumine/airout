{
  "expo": {
    "name": "AIrOut",
    "slug": "airout-mobile",
    "scheme": "airout",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.airout.mobile"
    },
    "android": {
      "package": "com.airout.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "bundler": "metro"
    }
  }
}
